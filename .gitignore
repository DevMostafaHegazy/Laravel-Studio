/build/
electron-app/build/
electron-app/dist/
electron-app/lib/
electron-app/src-gen/
extensions/*/lib/
extensions/*/dist/
extensions/*/*.tsbuildinfo
*.tsbuildinfo
/release/
/release-assets-*/
/release-watch-*.log
!vendor/windows-ca-certs/build/Release/
!vendor/windows-ca-certs/build/Release/**

