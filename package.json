{
  "name": "laravel-studio",
  "version": "1.0.3",
  "private": true,
  "description": "A free, local-first desktop IDE for Laravel with a JetBrains-inspired workbench.",
  "license": "MIT",
  "author": {
    "name": "Laravel Studio contributors",
    "email": "DevMostafaHegazy@users.noreply.github.com"
  },
  "homepage": "https://github.com/DevMostafaHegazy/Laravel-Studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevMostafaHegazy/Laravel-Studio.git"
  },
  "bugs": {
    "url": "https://github.com/DevMostafaHegazy/Laravel-Studio/issues"
  },
  "keywords": [
    "laravel",
    "php",
    "ide",
    "electron",
    "theia",
    "desktop"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "workspaces": [
    "electron-app",
    "extensions/laravel-tools"
  ],
  "scripts": {
    "build:extension": "npm run build --workspace @laravel-studio/laravel-tools",
    "build:app": "npm --prefix electron-app run bundle",
    "build": "npm run build:extension && npm run build:app",
    "start": "npm run build:extension && npm --prefix electron-app start",
    "watch:extension": "npm run watch --workspace @laravel-studio/laravel-tools",
    "fonts": "node scripts/fetch-fonts.mjs",
    "plugins": "node scripts/fetch-plugins.mjs",
    "postinstall": "node scripts/setup-local-plugins.mjs",
    "assets": "node scripts/generate-assets.mjs",
    "guide": "node scripts/generate-guide.mjs",
    "test": "npm run build:extension && node --test extensions/laravel-tools/lib/test/core.test.js && npm run test:backend",
    "test:backend": "node scripts/verify-backend.mjs",
    "measure:startup": "node scripts/measure-startup.mjs",
    "package:win": "npm run plugins && npm run build && npm --prefix electron-app run package:win",
    "package:linux": "npm run plugins && npm run build && npm --prefix electron-app run package:linux",
    "package:mac": "npm run plugins && npm run build && npm --prefix electron-app run package:mac",
    "package:mac:x64": "npm run plugins && npm run build && electron-builder --projectDir electron-app --mac dmg zip --x64 --publish never",
    "package:mac:arm64": "npm run plugins && npm run build && electron-builder --projectDir electron-app --mac dmg zip --arm64 --publish never"
  },
  "theiaPluginsDir": "plugins",
  "theiaPlugins": {
    "vscode-builtin-extensions": "https://github.com/eclipse-theia/vscode-builtin-extensions/releases/download/1.108.2/vscode-builtin-extensions-1.108.2.tar.gz",
    "bmewburn.vscode-intelephense-client": "https://open-vsx.org/api/bmewburn/vscode-intelephense-client/1.18.5/file/bmewburn.vscode-intelephense-client-1.18.5.vsix",
    "xdebug.php-debug": "https://open-vsx.org/api/xdebug/php-debug/1.40.2/file/xdebug.php-debug-1.40.2.vsix",
    "amiralizadeh9480.laravel-extra-intellisense": "https://open-vsx.org/api/amiralizadeh9480/laravel-extra-intellisense/0.7.4/file/amiralizadeh9480.laravel-extra-intellisense-0.7.4.vsix",
    "onecentlin.laravel-blade": "https://open-vsx.org/api/onecentlin/laravel-blade/1.38.0/file/onecentlin.laravel-blade-1.38.0.vsix",
    "onecentlin.laravel5-snippets": "https://open-vsx.org/api/onecentlin/laravel5-snippets/1.19.1/file/onecentlin.laravel5-snippets-1.19.1.vsix",
    "bradlc.vscode-tailwindcss": "https://open-vsx.org/api/bradlc/vscode-tailwindcss/0.16.0/file/bradlc.vscode-tailwindcss-0.16.0.vsix",
    "editorconfig.editorconfig": "https://open-vsx.org/api/EditorConfig/EditorConfig/0.18.2/file/EditorConfig.EditorConfig-0.18.2.vsix",
    "mikestead.dotenv": "https://open-vsx.org/api/mikestead/dotenv/1.0.1/file/mikestead.dotenv-1.0.1.vsix",
    "laravel.vscode-laravel": "https://open-vsx.org/api/laravel/vscode-laravel/2.0.1/file/laravel.vscode-laravel-2.0.1.vsix"
  },
  "theiaPluginsExcludeIds": [
    "ms-vscode.js-debug-companion",
    "vscode.extension-editing",
    "vscode.microsoft-authentication",
    "vscode.github-authentication",
    "vscode.github",
    "vscode.npm",
    "vscode.builtin-notebook-renderers",
    "vscode.clojure",
    "vscode.coffeescript",
    "vscode.cpp",
    "vscode.csharp",
    "vscode.dart",
    "vscode.fsharp",
    "vscode.go",
    "vscode.groovy",
    "vscode.grunt",
    "vscode.gulp",
    "vscode.handlebars",
    "vscode.hlsl",
    "vscode.ipynb",
    "vscode.jake",
    "vscode.java",
    "vscode.julia",
    "vscode.latex",
    "vscode.log",
    "vscode.lua",
    "vscode.make",
    "vscode.markdown-math",
    "vscode.mermaid-chat-features",
    "vscode.objective-c",
    "vscode.perl",
    "vscode.prompt",
    "vscode.pug",
    "vscode.python",
    "vscode.r",
    "vscode.razor",
    "vscode.restructuredtext",
    "vscode.ruby",
    "vscode.rust",
    "vscode.shaderlab",
    "vscode.swift",
    "vscode.tunnel-forwarding",
    "vscode.vb",
    "vscode.xml",
    "vscode.theme-abyss",
    "vscode.theme-kimbie-dark",
    "vscode.theme-monokai",
    "vscode.theme-monokai-dimmed",
    "vscode.theme-quietlight",
    "vscode.theme-red",
    "vscode.theme-solarized-dark",
    "vscode.theme-solarized-light",
    "vscode.theme-tomorrow-night-blue",
    "vscode.bat",
    "vscode.dotenv",
    "vscode.debug-auto-launch",
    "vscode.ini",
    "vscode.less",
    "vscode.merge-conflict",
    "vscode.powershell",
    "vscode.shellscript",
    "vscode.simple-browser",
    "ms-vscode.js-debug",
    "ms-vscode.vscode-js-profile-table",
    "amiralizadeh9480.laravel-extra-intellisense"
  ],
  "devDependencies": {
    "markdown-it": "^14.3.3",
    "playwright-core": "^1.64.1",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.5"
  }
}
