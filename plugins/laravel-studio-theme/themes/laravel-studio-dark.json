  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7f8c98",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.typeof",
        "keyword.operator.instanceof"
      ],
      "settings": {
        "foreground": "#fc5fa3"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string",
        "constant.character",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#fc6a5d"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#d0bf69"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "regexp"
      ],
      "settings": {
        "foreground": "#fc9c8d"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.class",
        "storage.type.interface",
        "meta.type.name"
      ],
      "settings": {
        "foreground": "#5dd8ff"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.method",
        "support.method"
      ],
      "settings": {
        "foreground": "#67b7a4"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "meta.definition.variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#d4d8e0"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.parent"
      ],
      "settings": {
        "foreground": "#fc5fa3",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#d4d8e0"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#a9b7c6"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "entity.name.tag.html",
        "entity.name.tag.php"
      ],
      "settings": {
        "foreground": "#5dd8ff"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#67b7a4"
      }
    },
    {
      "scope": [
        "constant.other.color.rgb-value",
        "support.constant.color"
      ],
      "settings": {
        "foreground": "#d0bf69"
      }
    },
    {
      "scope": [
        "valid",
        "support.constant.property-value"
      ],
      "settings": {
        "foreground": "#74d99d"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff8b8b"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.heading entity.name",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#5dd8ff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#c8d0de"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
